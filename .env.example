# Twitch application credentials from https://dev.twitch.tv/console/apps
# The Authorization Code grant requires a client secret ("New Secret" on the
# application page). The secret is only ever sent server-side.
CLIENT_ID=
CLIENT_SECRET=

# The single bot account that joins every channel, the way Nightbot uses one
# account across all the channels that add it.
BOT_USER_ID=
BOT_LOGIN=

# Neural Nexus avatar API
NEURAL_NEXUS_API_URL=
NEURAL_NEXUS_API_KEY=

# Avatar used in a channel that has not chosen one with !avatar
DEFAULT_ASSISTANT_ID=

# Optional overrides
# OAUTH_REDIRECT_URI=http://localhost:9070
# OAUTH_PORT=9070
# EVENTSUB_WEBSOCKET_URL=wss://eventsub.wss.twitch.tv/ws
# COMMAND_PREFIX=!
# COMMAND_COOLDOWN_MS=5000
# CHANNEL_SYNC_INTERVAL_MS=60000
# NEURAL_NEXUS_TIMEOUT_MS=20000

# Credential and channel state. Written by web-server.js, read by bot.js.
# Never commit these.
# TOKEN_STORE_PATH=.twitch-tokens/tokens.json
# CHANNEL_STORE_PATH=.twitch-tokens/channels.json
